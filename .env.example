# VeriLens configuration. Copy to `.env` and fill in the keys:
#     cp .env.example .env
# `.env` is gitignored and loaded by `python -m backend.api.flask_app`.
# On Render / Docker, set these as environment variables instead.
# Every value below except the keys is the built-in default.

# ---- live evidence (API keys) ------------------------------------
# Google Fact Check Tools API (GOOGLE_FACTCHECKER_API_KEY also works)
GOOGLE_FACTCHECK_KEY=
# Tavily web search, https://tavily.com
TAVILY_API_KEY=
# SerpAPI reverse image search (optional)
SERPAPI_KEY=

# ---- Flask API server --------------------------------------------
HOST=127.0.0.1
PORT=5000
DEBUG=false
# Origins allowed to call the API from another site, comma-separated
# (the Vercel frontend in production). Empty = same-origin only.
CORS_ORIGINS=

# ---- cache -------------------------------------------------------
CACHE_DIR=cache
CACHE_DISABLED=false
# 0 = cached responses never expire
CACHE_TTL_DAYS=0

# ---- claim extraction ----------------------------------------------
# auto | transformer | ollama | heuristic
CLAIM_BACKEND=auto
CLAIM_NER_MODEL=dslim/bert-base-NER
CLAIM_ZSC_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
OLLAMA_HOST=http://localhost:11434
CLAIM_OLLAMA_MODEL=qwen2.5:7b
CLAIM_OLLAMA_TIMEOUT=120

# ---- stance and images -------------------------------------------
STANCE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLIP_IMAGE_MODEL=clip-ViT-B-32
CLIP_TEXT_MODEL=clip-ViT-B-32-multilingual-v1
CLIP_MIN_SIMILARITY=0.2
# Optional Hugging Face model for the AI-generated image hint
AI_DETECTOR_MODEL=

# ---- performance ---------------------------------------------------
# Torch CPU threads; leave empty for torch's default. 1-2 on low-RAM boxes.
MISINFO_TORCH_THREADS=
